{
  "name": "@nayaverse/verify-deploy",
  "version": "0.1.0",
  "description": "Assert the public URL serves the build you just shipped, and that every route answers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "verify-deploy": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "deploy",
    "verify",
    "smoke-test",
    "ci",
    "prerender",
    "static-site"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js",
    "pretest": "npm run build",
    "usage": "node dist/src/cli.js --help"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  }
}
