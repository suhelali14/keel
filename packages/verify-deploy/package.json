{
  "name": "@nayaverse/verify-deploy",
  "version": "0.1.1",
  "description": "Assert the public URL serves the build you just shipped, and that every route answers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "verify-deploy": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "keywords": [
    "deploy",
    "verify",
    "smoke-test",
    "ci",
    "prerender",
    "static-site"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js",
    "pretest": "npm run build",
    "usage": "node dist/src/cli.js --help",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suhelali14/keel.git",
    "directory": "packages/verify-deploy"
  },
  "homepage": "https://github.com/suhelali14/keel/tree/main/packages/verify-deploy#readme",
  "bugs": {
    "url": "https://github.com/suhelali14/keel/issues"
  },
  "author": "Suhelali Pakjade",
  "sideEffects": false
}
