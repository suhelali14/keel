{
  "name": "keel",
  "private": true,
  "type": "module",
  "description": "Deployment tooling that verifies reality, not the build.",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "workspaces": ["packages/*"],
  "scripts": {
